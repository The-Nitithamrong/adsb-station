[Unit]
Description=THA inbound flight watcher (ADS-B -> Telegram + SQLite)
After=network-online.target dump1090-mutability.service
Wants=network-online.target

[Service]
Type=simple
User=arin
WorkingDirectory=/home/arin/adsb-station/flightwatch
ExecStart=/usr/bin/python3 /home/arin/adsb-station/flightwatch/flight_watcher.py
Restart=always
RestartSec=10
# สร้าง /run/flight-watcher (owned by arin) → เขียน inbound.json ให้ Pixoo
# (ค่าต้องไม่มี comment ท้ายบรรทัด — systemd อ่านทั้งบรรทัดเป็นชื่อ dir)
RuntimeDirectory=flight-watcher

[Install]
WantedBy=multi-user.target
