# config.env.example — peer-watchdog (Pi#2). คัดลอกเป็น /etc/fleet-peer-watchdog.env แล้วเติมค่า.
# systemd unit โหลดไฟล์นี้ผ่าน EnvironmentFile=. อย่า commit ไฟล์จริง (มี secret + webhook).

# ---- ปลอดภัยไว้ก่อน: ติดตั้งครั้งแรกให้ DRY_RUN=1 (log เจตนา ไม่ทำ action จริง) ----
# พิสูจน์ ladder ครบ L0→L3 บน log/Telegram ก่อน แล้วค่อยตั้ง 0 เพื่อเปิดของจริง.
DRY_RUN=1

# ---- MQTT broker (Mosquitto — อยู่บน Pi#2 เดียวกันนี้) ----
BROKER_HOST=127.0.0.1
BROKER_PORT=1883
BROKER_USER=
BROKER_PASS=

# ---- Pi#1 (ตัวที่เฝ้า) ----
PI1_IP=192.168.41.241
STATION_ID=pi-adsb

# ---- SSH เข้า Pi#1 (L2) — key ผูก forced-command ฝั่ง Pi#1 (รับแค่ restart-services/reboot/status) ----
SSH_USER=arin
SSH_PORT=22
SSH_KEY=/home/pi/.ssh/fleet_id

# ---- L3 ตัดไฟ: HA webhook (HA automation ทำ off→delay→on) ----
# ⚠️ Pi#2 ต้องเสียบไฟคนละปลั๊กกับ Pi#1 ไม่งั้นตัดแล้วตัวเองตายด้วย.
HA_WEBHOOK_CYCLE=https://YOUR-HA-HOST/api/webhook/pi1-power-cycle

# ---- แจ้งเตือน (reuse ชุดเดียวกับ fr24-watchdog) ----
TG_API=
TG_CHAT=
HC_URL=

# ---- อื่นๆ (ดีฟอลต์พอใช้) ----
# STATE_PATH=/var/lib/fleet/state.json
# TICK_S=15
