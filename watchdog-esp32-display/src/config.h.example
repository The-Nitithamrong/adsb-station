// config.h.example — คัดลอกเป็น src/config.h แล้วเติมค่า
// (src/config.h ไม่ขึ้น repo — อยู่ใน .gitignore เพราะมี wifi pass + tuya local_key)
#pragma once

// --- WiFi (วงเดียวกับ Pi + ปลั๊ก Tuya) ---
#define WIFI_SSID   "Arin II"
#define WIFI_PASS   "<wifi password>"

// --- Pi ที่จะเฝ้า ---
#define PI_IP       "192.168.41.241"
#define PI_PORT     22          // พอร์ตที่เช็ค liveness (22=SSH — เปิดเสมอถ้า network stack ของ Pi มีชีวิต)
#define PI_INFO_PORT 8099       // พอร์ต adsb-uptime.service บน Pi — ดึง uptime จริงมาโชว์ (display-only)

// --- Home Assistant Webhook (คุมปลั๊กผ่าน HA — ไม่ต้องมี token/auth) ---
// ยิง webhook เดียว → automation เดียวใน HA ทำ turn_off → delay OFF_SECONDS → turn_on ครบวงจร
// (HA เป็นคนจับเวลา ปลั๊กเปิดกลับเองแม้ ESP32 หลุด WiFi หลังยิง)
// ⚠️ ตอนทดสอบ (HA ยังบน ADS-B Pi) ให้ automation ตัด "ปลั๊กตัวอื่น" เท่านั้น ห้ามตัดปลั๊กของ Pi ที่รัน HA
#define HA_WEBHOOK_CYCLE  "http://192.168.41.241:8123/api/webhook/xxxxxxxx"

// --- จูน ---
#define CHECK_MS        30000UL     // เช็ค Pi ทุกกี่ ms (30 วิ)
// DOWN_MS = threshold ของ ESP32 (ชั้นที่ 3, backstop สุดท้าย). ต้อง "หลัง" peer-watchdog (Pi#2)
// ลองครบ: L3 ตัดไฟที่ POWER_CYCLE_S=600s + รอ POST_POWER_WAIT_S=240s + Pi boot ~120s ≈ 16 นาที.
// ตั้ง 20 นาที = เผื่อ margin ไม่ยิงซ้อนตอน Pi กำลัง boot จากการตัดของชั้น 2. (ดู shared/pylib/fleet_mqtt.py)
#define DOWN_MS         1200000UL   // Pi เงียบเกินกี่ ms → auto power-cycle (1200000 = 20 นาที)
#define OFF_SECONDS     60          // เวลานับถอยหลังบนจอ — ตั้งให้ตรงกับ delay ใน HA automation
#define COOLDOWN_MS     1500000UL   // หลัง cycle เว้นกี่ ms ก่อน auto-cycle ใหม่ (1500000 = 25 นาที)
#define TCP_TIMEOUT_MS  4000        // timeout ต่อการเช็ค Pi 1 ครั้ง

// --- ทดสอบ ---
#define DRY_RUN         1           // 1 = ทดสอบ UI/ปุ่ม/countdown โดยไม่ยิง HA จริง
                                    // ตั้ง 0 เมื่อใส่ HA_WEBHOOK_CYCLE แล้ว (ถึงจะตัด-เปิดไฟจริง)
