// config.h.example — คัดลอกเป็น src/config.h แล้วเติมค่า
// (src/config.h ไม่ขึ้น repo — อยู่ใน .gitignore เพราะมี wifi pass + tuya local_key)
#pragma once

// --- WiFi (วงเดียวกับ Pi + ปลั๊ก Tuya) ---
#define WIFI_SSID   "Arin II"
#define WIFI_PASS   "<wifi password>"

// --- Pi ที่จะเฝ้า ---
#define PI_IP       "192.168.41.241"
#define PI_PORT     22          // พอร์ตที่เช็ค (22=SSH — เปิดเสมอถ้า network stack ของ Pi มีชีวิต)

// --- Home Assistant (คุมปลั๊กผ่าน HA REST API — ไม่ต้องมี Tuya local_key) ---
#define HA_BASE     "http://192.168.41.241:8123"   // IP:port ของ HA (เปลี่ยนเป็น Pi ใหม่ตอนย้าย HA)
#define HA_TOKEN    "<HA long-lived access token>" // HA → โปรไฟล์ → Long-lived access tokens → Create
// ⚠️ entity ที่จะตัด — ตอนทดสอบ (HA ยังบน ADS-B Pi) ใช้ปลั๊ก/switch "ตัวอื่น" เท่านั้น
//    ห้ามใช้ปลั๊กของ Pi ที่รัน HA (สั่ง OFF → HA ตาย → สั่ง ON ไม่ได้ → Pi ค้างดับ)
#define HA_ENTITY   "switch.your_plug"

// --- จูน ---
#define CHECK_MS        30000UL     // เช็ค Pi ทุกกี่ ms (30 วิ)
#define DOWN_MS         900000UL    // Pi เงียบเกินกี่ ms → auto power-cycle (900000 = 15 นาที)
#define OFF_SECONDS     60          // ตัดไฟค้างกี่วินาที (= เวลานับถอยหลังบนจอ)
#define COOLDOWN_MS     1500000UL   // หลัง cycle เว้นกี่ ms ก่อน auto-cycle ใหม่ (1500000 = 25 นาที)
#define TCP_TIMEOUT_MS  4000        // timeout ต่อการเช็ค Pi 1 ครั้ง

// --- ทดสอบ ---
#define DRY_RUN         1           // 1 = ทดสอบ UI/ปุ่ม/countdown โดยไม่ยิง HA จริง
                                    // ตั้ง 0 เมื่อใส่ HA_TOKEN/HA_ENTITY แล้ว (ถึงจะตัด-เปิดไฟจริง)
